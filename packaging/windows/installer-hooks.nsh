; Tauri NSIS installer hooks (bundle.windows.nsis.installerHooks).
; Install: the app writes its own Explorer menu (src-tauri/src/context_menu.rs:
; built-in or saved presets, Chinese labels) and exits without opening a
; window; every app start then rewrites it in the app's language. Starting the
; app also moves the pre-rename SORAI Toolkit data into downco's folders
; (src-tauri/src/migrate.rs), so when SORAI Toolkit is installed the hook first
; stops it, then (after the menu step) silently uninstalls it: its shortcuts,
; Apps entry and folder go; its data was already moved.
; Uninstall: delete each extension's menu subtree, both the current
; SystemFileAssociations location and 2.0.0's .<ext>\shell, under the current
; name and the pre-rename SORAIToolkit, then each shell key if that left it
; empty. The extension list mirrors context_menu.rs INPUT_EXTS (a cargo test
; checks it).
; Post-uninstall (the app is closed by then): delete engines the app
; downloaded (converter engines.rs: %LOCALAPPDATA%\<identifier>\engines),
; except when an update runs this uninstaller (/UPDATE): updates keep them.
!define OLD_UNINSTKEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\SORAI Toolkit"

!macro NSIS_HOOK_POSTINSTALL
  ReadRegStr $R7 HKCU "${OLD_UNINSTKEY}" "UninstallString"
  ReadRegStr $R8 HKCU "${OLD_UNINSTKEY}" "InstallLocation"
  ${If} $R7 != ""
    nsExec::Exec '"$SYSDIR\taskkill.exe" /F /IM sorai-toolkit.exe'
    Pop $R9
    Sleep 500
  ${EndIf}
  ExecWait '"$INSTDIR\${MAINBINARYNAME}.exe" --sorai-register-menu'
  ${If} $R7 != ""
  ${AndIf} $R8 != ""
    ; Both values are stored quoted. _?= runs the old uninstaller in place,
    ; so it can't delete itself or its folder: done here afterwards.
    ExecWait '$R7 /S _?=$R8'
    StrCpy $R8 $R8 "" 1
    StrCpy $R8 $R8 -1
    Delete "$R8\uninstall.exe"
    RMDir "$R8"
  ${EndIf}
!macroend

